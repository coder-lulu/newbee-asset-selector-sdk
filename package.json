{
  "name": "@newbee/asset-selector-sdk",
  "version": "1.0.0",
  "description": "通用资产选择器SDK - 支持多微服务集成的资产选择组件",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:watch": "rollup -c rollup.config.js -w",
    "dev": "vite serve example",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm publish"
  },
  "keywords": [
    "asset-selector",
    "cmdb",
    "vue",
    "typescript",
    "microservice",
    "component",
    "selector",
    "asset-management"
  ],
  "author": "NewBee Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coder-lulu/newbee-asset-selector-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/coder-lulu/newbee-asset-selector-sdk/issues"
  },
  "homepage": "https://github.com/coder-lulu/newbee-asset-selector-sdk#readme",
  "peerDependencies": {
    "vue": "^3.3.0",
    "ant-design-vue": "^4.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.0",
    "rollup": "^4.6.0",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-postcss": "^4.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-vue": "^6.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
